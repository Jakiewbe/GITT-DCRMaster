{
  "name": "pulselab-gitt-dcr",
  "private": true,
  "version": "0.1.0-beta.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:oracle": "vitest run tests/oracles/oracle_pack.test.ts",
    "test:qualification": "vitest run --config vitest.qualification.config.ts",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "check": "npm run typecheck && npm run lint && npm run test:run && npm run build",
    "tauri": "tauri",
    "tauri:info": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-d-drive.ps1 -Action info",
    "tauri:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-d-drive.ps1 -Action dev",
    "tauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-d-drive.ps1 -Action build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@zip.js/zip.js": "^2.8.31",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.0.0"
  }
}
